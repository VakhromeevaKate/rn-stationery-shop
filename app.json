{
  "expo": {
    "name": "Аптека",
    "slug": "pharmacy-catalog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/colorful-pencils-concept-with-copy-space.jpg",
    "backgroundColor": "transparent",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "package": "com.vakhromeevae.stationeryshop",
        "googleServicesFile": "./google-services.json",
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/colorful-pencils-no-background.png",
        "backgroundImage": "./assets/colorful-pencils-concept-with-copy-space.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vakhromeevae.stationeryshop"
    },
    "splash": {
      "image": "./assets/colorful-pencils-no-background.png",
      "resizeMode": "cover",
      "backgroundColor": "transparent"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "vakhromeevae",
    "scheme": "stationeryshop",
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}